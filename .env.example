# Copy to .env and update to match your machine.
KB_PATH=/path/to/your/docs

# Optional: keep indexes outside the source folder.
# INDEX_PATH=/path/to/your/indexes

# Optional: switch embedding model.
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Optional: evaluation (copy tools/eval/golden_queries.example.yaml to tools/eval/golden_queries.yaml locally).
# EVAL_GOLDEN_QUERIES=/path/to/golden_queries.yaml

# Optional: tools/convert_to_markdown.py
# CONVERT_SOURCE_PATH=/path/to/source-docs
# CONVERT_MARKDOWN_OUT=/path/to/markdown-mirror
